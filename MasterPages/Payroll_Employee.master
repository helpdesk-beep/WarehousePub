<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Payroll_Employee.master.cs" Inherits="Masters_Payroll_Employee" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- The above 3 meta tags *must* come first in the head; any other head content must come *after* these tags -->
    <meta name="description" content="">
    <meta name="author" content="">
    <title>MP Warehouse Paybill System</title>

    <style type="text/css">
        header, nav, section, article, aside, footer {
            display: block;
        }
    </style>
    <!--[if lt IE 9]>
   <script>
      document.createElement('header');
      document.createElement('nav');
      document.createElement('section');
      document.createElement('article');
      document.createElement('aside');
      document.createElement('footer');
   </script>
<![endif]-->
    <link href="/Paybillmgm/assets/css/style.css" rel="stylesheet" />
    <!-- Bootstrap core CSS -->
    <link href="/Paybillmgm/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/bootstrap-theme.min.css" rel="stylesheet" type="text/css" />

    <!-- font awesome -->
    <link href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">

    <link href="/Paybillmgm/assets/css/style.css" rel="stylesheet" type="text/css">
    <link href="/Paybillmgm/assets/css/custome.css" rel="stylesheet" type="text/css">

    <link rel="stylesheet" href="http://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" />
    <link rel="stylesheet" href="http://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" />
    <link href="/Paybillmgm/CSS/style.css" rel="stylesheet" />
    <style>
        * {
            margin: 0px;
            padding: 0px;
        }

        ul {
            list-style: none;
        }

        a {
            text-decoration: none;
        }

        .clear {
            clear: both;
        }

        .wrap {
            width: 1200;
            margin: auto;
        }

        .navtop {
            /*background: #333;*/
            height: 30px;
            color: #fff;
        }

            .navtop > ul {
                position: relative;
                z-index: 1;
            }

                .navtop > ul > li {
                    float: left;
                    border-left: 1px solid #fff;
                }

            .navtop ul li a {
                display: block;
                padding: 10px 20px;
                color: #ccc;
            }

                .navtop ul li a:hover {
                    background: #1e364a;
                    color: #fff;
                }

            .navtop ul li:first-child {
                border: none;
            }

            .navtop > ul > li:hover > ul {
                display: block;
            }

            .navtop > ul > li > ul > li:hover ul {
                display: block;
            }

            .navtop > ul > li > ul li {
                height: 41px;
            }

            .navtop > ul > li > ul {
                display: none;
                position: absolute;
                background: #333;
            }

                .navtop > ul > li > ul > li > ul {
                    display: none;
                    position: relative;
                    left: 132px;
                    top: -41px;
                    background: #333;
                }

            .navtop ul ul li {
                border-top: 1px solid #fff;
            }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <header>
            <div class="top_bar">
                <div class="container">
                    <%--<span class="pull-left"><i>Call Us :+9123456789</i></span>--%>
                    <span class="pull-right">
                        <asp:LinkButton ID="LinkButton1" OnClick="lb_logout_Click"
                            runat="server" CssClass="btn btn-info">Logout </asp:LinkButton></span>
                </div>
            </div>

            <div class="logo_bar">
                <div class="container">
                  <span class="pull-left" style="font-size:30px;">MP Warehouse Paybill System</span>
                  <span class="pull-right" style="font-size:30px;">User:<asp:Label ID="lblusername" runat="server"></asp:Label> </span>
                    <asp:Label ID="lblrole" runat="server" Visible="false"></asp:Label>
                </div>
            </div>
        </header>
        <nav class="navbar">
            <div class="container">
                <!-- Brand and toggle get grouped for better mobile display -->
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1" aria-expanded="false">
                        <span class="sr-only">Toggle navigation</span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>
                    <!-- <a class="navbar-brand" href="#">Human Resource Management System</a> -->
                </div>

             
                <div class="wrap">
                    <div class="navtop">
                        <ul>
                            <li><a href="/Employee/Default.aspx">Home</a></li>                            
                            <li><a href="#"><b class="caret"></b>Salary Slip</a>
                                <ul>
                                    <li><a href="/Employee/Generate_Salry_Slip.aspx">Salary Slip</a> </li>
                                </ul>
                            </li>
                             <li><a href="#"><b class="caret"></b>Update Details</a>
                                <ul>
                                    <li><a href="/Employee/Edit_Employee_Details.aspx">Update Employee Personal Details</a> </li>
                                </ul>
                            </li>
                            <li>
                                <asp:LinkButton ID="lb_logout" OnClick="lb_logout_Click"
                                    runat="server" CssClass="dropdown-item">Logout </asp:LinkButton></li>
                        </ul>
                        <div class="clear"></div>
                    </div>
                    <!--Nav Ends-->
                </div>            
            </div>
            <!-- /.container-fluid -->
        </nav>
        <div style="min-height: 400px;">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
        <%--<footer>
            <div class="container">
                Copyright &copy; 2020 MPWLC - All Rights Reserved | Madhya Pradesh Warehousing and Logistics Corporation
            </div>
        </footer>--%>
         <script src='http://www.pib.nic.in/js/jquery.flexisel.js'></script>
    <footer>            
           
            <div class="footer-bottom">
                <div class="container">
                  
                    <p style="text-align: center;">
                       Copyright &copy; 2020 MPWLC - All Rights Reserved | Madhya Pradesh Warehousing and Logistics Corporation
                    </p>

                    <div class="clearfix"></div>
                </div>
            </div>
        </footer>
    </form>


    <!--Java Script -->
    <script src="<%= ResolveUrl("~/NEW_CSS/js/jquery-1.12.4.js") %>"></script>
    <script src="<%= ResolveUrl("~/assets/js/bootstrap.min.js") %>"></script>
    <script type="text/javascript" src="/Paybillmgm/assets/js/custom.js"></script>
    <script src="<%= ResolveUrl("~/NEW_CSS/js/jquery-1.12.4.js") %>" type="text/javascript"></script>
    <script src="/Paybillmgm/scripts/jquery.blockUI.js" type="text/javascript"></script>
    <script type="text/javascript" src="<%= ResolveUrl("~/NEW_CSS/js/jquery-1.12.4.js") %>"></script>
    <script type="text/javascript" src="<%= ResolveUrl("~/assets/js/bootstrap.min.js") %>"></script>
</body>
</html>
